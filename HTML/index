<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="WineBank on View — curated Australian wine, dining and member experiences in Bendigo." />
  <title>WineBank on View | Wine, Dining & Membership</title>
  <link rel="stylesheet" href="./css/global.css" />
  <link rel="stylesheet" href="./css/home.css" />
</head>
<body>
<header class="site-header">
  <a class="site-logo" href="#top" aria-label="WineBank home">WINE BANK on View </a>
  <nav class="site-nav" aria-label="Main navigation">
    <a href="#shop">Shop</a><a href="#experience">Experience</a><a href="#membership">Membership</a><a href="#events">Events</a><a href="#contact">Contact</a>
    <a class="nav-cta" href="./login.html">Member Login</a>
    <a class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false"></a>
    <button class="cart-button" type="button" id="openCart">Bag <span id="cartCount">0</span></button>
  </nav>
</header>

<main id="top">
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content reveal">
      <p class="hero-kicker">Bendigo · Wine · Dining · Membership</p>
      <h1>Remarkable wine.<br />Unforgettable company.</h1>
      <p>Discover a curated collection of Australian wines and experiences from the heart of Bendigo.</p>
      <div class="hero-actions">
        <a class="primary-button" href="#shop">Explore the cellar</a>
        <a class="secondary-button light-button" href="#experience">Visit WineBank</a>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Service highlights">
    <div><strong>Curated locally</strong><span>Selected by our cellar team</span></div>
    <div><strong>Complimentary pickup</strong><span>From WineBank on View</span></div>
    <div><strong>Member privileges</strong><span>Events, offers and first access</span></div>
  </section>

  <section class="section" id="shop">
    <div class="section-heading">
      <div><p class="eyebrow">The cellar</p><h2>Featured bottles</h2></div>
      <p>Explore a showcase collection of regional favourites. Checkout is disabled in this demonstration.</p>
    </div>
    <div class="shop-toolbar">
      <div class="filter-group" role="group" aria-label="Filter wines">
        <button class="filter-button active" data-filter="all">All</button>
        <button class="filter-button" data-filter="red">Red</button>
        <button class="filter-button" data-filter="white">White</button>
        <button class="filter-button" data-filter="sparkling">Sparkling</button>
      </div>
      <label class="search-box"><span class="sr-only">Search wines</span><input id="wineSearch" type="search" placeholder="Search the cellar" /></label>
    </div>
    <div class="product-grid" id="productGrid"></div>
    <p class="empty-state" id="emptyState" hidden>No wines match your search.</p>
  </section>

  <section class="split-section" id="experience">
    <div class="split-image experience-image" role="img" aria-label="Wine glasses in a warm cellar"></div>
    <div class="split-content">
      <p class="eyebrow">More than a bottle</p><h2>The WineBank experience</h2>
      <p>Set inside a historic Bendigo bank, WineBank brings together regional wine, thoughtful dining and warm hospitality.</p>
      <div class="feature-list"><div><strong>Cellar tastings</strong><span>Guided flights from local and Australian producers.</span></div><div><strong>Seasonal dining</strong><span>Menus designed to complement the cellar.</span></div><div><strong>Private occasions</strong><span>Intimate spaces for celebrations and gatherings.</span></div></div>
      <a class="text-link" href="#contact">Plan your visit →</a>
    </div>
  </section>

  <section class="membership-section" id="membership">
    <div class="membership-copy"><p class="eyebrow">WineBank membership</p><h2>Your place at the table</h2><p>Enjoy priority invitations, selected offers and first access to limited releases.</p><a class="primary-button" href="./signup.html">Become a member</a></div>
    <div class="benefit-grid"><article><span>01</span><h3>Member pricing</h3><p>Selected cellar offers throughout the year.</p></article><article><span>02</span><h3>Private events</h3><p>Invitations to tastings and winemaker dinners.</p></article><article><span>03</span><h3>First access</h3><p>Early access to limited releases and experiences.</p></article></div>
  </section>

  <section class="section events-section" id="events">
    <div class="section-heading"><div><p class="eyebrow">What’s on</p><h2>Upcoming experiences</h2></div></div>
    <div class="event-grid"><article><p class="event-date">14 SEP</p><div><h3>Regional Reds Tasting</h3><p>A guided journey through premium Central Victorian reds.</p></div><button class="secondary-button event-button" data-event="Regional Reds Tasting">Register interest</button></article><article><p class="event-date">28 SEP</p><div><h3>Winemaker Dinner</h3><p>A seasonal menu paired with a featured local producer.</p></div><button class="secondary-button event-button" data-event="Winemaker Dinner">Register interest</button></article></div>
  </section>

  <section class="contact-section" id="contact">
    <div>
      <p class="eyebrow">Visit us</p>
      <h2>45 View Street, Bendigo</h2>
      <p>Wednesday–Sunday · 12 pm until late<br />Demonstration contact details only.</p>
    </div>
    <div class="contact-map">
      <iframe
          src="https://www.google.com/maps?q=45+View+Street+Bendigo+VIC&output=embed"
          loading="lazy"
          allowfullscreen>
      </iframe>
  </div>
    <form class="contact-form" id="contactForm"><div class="field-row"><label>Name<input id="contactName" required /></label><label>Email<input id="contactEmail" type="email" required /></label></div><label>Message<textarea id="contactMessage" rows="4" required></textarea></label><button class="primary-button" type="submit">Send enquiry</button><p class="form-message" id="contactStatus" aria-live="polite"></p></form>
  </section>
</main>

<footer class="site-footer"> 
  <div class="site-footer-inner"> 
    <div> 
      <a class="footer-logo" href="#top">WINEBANK</a>
      <p>Wine, dining and community in Bendigo.</p>
    </div>
    <div>
      <strong>Explore</strong> 
      <a href="#shop">Shop</a>
      <a href="#membership">Membership</a>
      <a href="#events">Events</a>
    </div>  
    <div class="footer-column">
      <h3>Find Us</h3>
      <p>
          WineBank Bendigo<br>
          45 View Street<br>
          Bendigo VIC 3550<br><br>
  
          Phone: (03) 5440 1234<br>
          Email: info@winebank.com.au
      </p>
  </div>
    <!-- <div> 
      <strong>Account</strong> 
      <a href="./login.html">Member login</a>
      <a href="./signup.html">Create account</a>
    </div> -->
  </div>
  <div class="footer-bottom">
    
    <span>© 2026 WineBank on View </span>
  <span>Enjoy responsibly. 18+ only.</span>

  </div>
</footer>

<aside class="cart-drawer" id="cartDrawer" aria-hidden="true" aria-label="Shopping bag"><div class="cart-header"><h2>Your bag</h2><button id="closeCart" class="icon-button" aria-label="Close bag">×</button></div><div class="cart-items" id="cartItems"></div><div class="cart-footer"><div class="cart-total"><span>Total</span><strong id="cartTotal">$0.00</strong></div><button class="primary-button" id="checkoutButton">Demo checkout</button><small>No payment is processed in this prototype.</small></div></aside>
<div class="drawer-backdrop" id="drawerBackdrop"></div>

<div class="modal" id="ageModal" role="dialog" aria-modal="true" aria-labelledby="ageTitle"><div class="modal-card"><p class="eyebrow">Welcome to WineBank</p><h2 id="ageTitle">Are you 18 or older?</h2><p>You must be of legal drinking age to enter this demonstration website.</p><div class="modal-actions"><button class="primary-button" id="confirmAge">Yes, enter site</button><button class="secondary-button" id="denyAge">No, leave</button></div><small>Enjoy responsibly.</small></div></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script type="module" src="./js/home.js"></script>
</body>
</html>

