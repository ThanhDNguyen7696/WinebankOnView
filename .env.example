# Copy this file to .env.local and fill in your Supabase project values.
# These two values are public browser configuration, not server secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Vercel variables used by /api/function-enquiry.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=WineBank Website <onboarding@resend.dev>
FUNCTION_ENQUIRY_TO=lucaslewis741@gmail.com

# Never place a Supabase service-role key in this repository or in browser code.

# Server-only Vercel variables used by /api/square-catalog (the Cellar page).
# Create the token at developer.squareup.com > your app > Credentials.
SQUARE_ACCESS_TOKEN=YOUR_SQUARE_ACCESS_TOKEN
SQUARE_ENVIRONMENT=production
# Optional: the Square location that takes Cellar orders. Needed only when the
# Square account has more than one active location.
SQUARE_LOCATION_ID=

# Optional, for testing payments: point checkout at a Square sandbox account
# while the Cellar keeps showing the real catalogue. Remove before going live.
# SQUARE_CHECKOUT_ACCESS_TOKEN=YOUR_SANDBOX_ACCESS_TOKEN
# SQUARE_CHECKOUT_ENVIRONMENT=sandbox
# SQUARE_CHECKOUT_LOCATION_ID=
