# Copy this file to .env.local and fill in your Supabase project values.
# These two values are public browser configuration, not server secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Vercel variables used by /api/function-enquiry.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=WineBank Website <onboarding@resend.dev>
FUNCTION_ENQUIRY_TO=lucaslewis741@gmail.com

# Never place a Supabase service-role key in this repository or in browser code.
