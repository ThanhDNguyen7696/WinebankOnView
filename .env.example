# Copy this file to .env.local and fill in your Supabase project values.
# These two values are public browser configuration, not server secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Never place a Supabase service-role key in this repository or in browser code.
